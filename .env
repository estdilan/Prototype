VITE_DEEPGRAM_TOKEN=0399b2cf6f45a20e28f5db7f38d3f952ffce5917

# Motor de voz: 'deepgram' (default, requiere internet) o 'vosk' (offline, requiere modelo en public/models/)
VITE_VOICE_ENGINE=vosk

# URL del modelo Vosk en español. Si se sirve desde public/models/, dejar el path por defecto.
# Descargar de https://alphacephei.com/vosk/models -> vosk-model-small-es-0.42.zip (~40MB)
# y dejar el .tar.gz en public/models/
VITE_VOSK_MODEL_URL=/models/vosk-model-small-es-0.42.zip
